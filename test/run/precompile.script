-- A call script for examples/precompile.lang (S4, O62). The guest run gives the Env fields
-- chainid and self the `evm run` defaults: the chain 1337 and the address of the bytes "receiver".
1 0x00000000000000000000000000000000000000aa chainWord
2 0x00000000000000000000000000000000000000aa selfAddr
-- S6 s2 part 3 (Q-S6-1 (a)): an IO entry prints `K NAME OP WORD` at each operation. The next line is the answer `OP WORDS`.
3 0x00000000000000000000000000000000000000aa askWord 5u
show 6u
lookup 7u
submit 8u
-- The answer to confirm is the Sig `v r s`. tConfirmSig gives ok. The same r and s with v 27 give revert.
4 0x00000000000000000000000000000000000000aa askConfirm
confirm 28 0x78b80540c8c6d56aa320eeb4823bfccb22e1c2fc8f7e3a17fb47a413aaaf3d13u 0x7445b967ce3d94ac2d3ddef8cd780b4d41212f2fca976ba885f818f8e37f8f1eu
5 0x00000000000000000000000000000000000000aa askConfirm
confirm 27 0x78b80540c8c6d56aa320eeb4823bfccb22e1c2fc8f7e3a17fb47a413aaaf3d13u 0x7445b967ce3d94ac2d3ddef8cd780b4d41212f2fca976ba885f818f8e37f8f1eu
-- Typed show and lookup use three word answers: v, r and s. Each request
-- binds the EIP-712 digest and a component tag. The altered root and sid
-- must revert with the same signature. A bad v word must also revert.
6 0x00000000000000000000000000000000000000aa askView 0x13cb0cf25603c21f60aa611efe8bd04bbd3b5bff5c45b4f389a7d34d18bf78b7u
show 28u
show 0x001509326abd87ce721c568dfb954ba06474d78a5384d3571d42c8c8c867e25bu
show 0x7948bf8d80125edd9353cdd3e7ac2685a02fdd75e55bca7b769251e173b66ef4u
7 0x00000000000000000000000000000000000000aa askView 0u
show 28u
show 0x001509326abd87ce721c568dfb954ba06474d78a5384d3571d42c8c8c867e25bu
show 0x7948bf8d80125edd9353cdd3e7ac2685a02fdd75e55bca7b769251e173b66ef4u
8 0x00000000000000000000000000000000000000aa askLookup 11u
lookup 27u
lookup 0x7d8048c414b3f2313f6c824e5a9a90e558edd061e44958b00799b56ba6b1bce0u
lookup 0x2a04fbd3c89d290121964e94c1726fe10ee8c0e277b48542fec3b33a5309b833u
9 0x00000000000000000000000000000000000000aa askLookup 10u
lookup 27u
lookup 0x7d8048c414b3f2313f6c824e5a9a90e558edd061e44958b00799b56ba6b1bce0u
lookup 0x2a04fbd3c89d290121964e94c1726fe10ee8c0e277b48542fec3b33a5309b833u
