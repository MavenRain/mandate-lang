-- The mandate contract (S7 s2, PLAN section 7, Q-S7-1 (a)): one contract for each user, the EIP-7702 delegate of the user account.
-- The state holds the 11 words of the mandate, the merchant (Q-S7-8 (b), O135), spent, used (a Map U256 U256 of the used session ids, O16, O93) and revoked.
-- The start state has revoked = flagYes: before grant and after revoke, check gives NO_MANDATE (O115).
state State := makeState (mOwner : Addr) (mAgent : Addr) (mViewer : Addr) (mVault : Addr) (mToken : Addr) (mCap : U256) (mAutoLimit : U256) (mExpiry : U256) (mId : U256) (mPolicyVerifier : Addr) (mPolicyId : U256) (mMerchant : Addr) (spent : U256) (used : Map U256 U256) (revoked : Flag)

def init : State := makeState 0x0000000000000000000000000000000000000000 0x0000000000000000000000000000000000000000 0x0000000000000000000000000000000000000000 0x0000000000000000000000000000000000000000 0x0000000000000000000000000000000000000000 0u 0u 0u 0u 0x0000000000000000000000000000000000000000 0u 0x0000000000000000000000000000000000000000 0u mapEmpty flagYes

-- The event of execute (O118): the session id, the cart hash and the total.
event Spent (spentSid : U256) (spentCart : U256) (spentTotal : U256)

-- BEGIN COPY of examples/precompile.lang, the defs from Hash to Spend (Q-S7-1 (a)). A gate row compares the two copies: do not change them here.
def Hash : Type 0 := U256

def Sig : Type 0 := Prod Nat (Prod U256 U256)

def sig : (v : Nat) -> (r w : U256) -> Sig := fun (v : Nat) (r w : U256) => pair v (pair r w)

-- signer d g x: the address that signed the EIP-712 digest of the domain separator d and the struct hash g.
-- An invalid signature gives the address 0 (R18): the address 0 is no signer.
def signer : (d g : Hash) -> (x : Sig) -> Addr :=
  fun (d g : Hash) (x : Sig) => ecrecover (hash712 d g) (first x) (first (second x)) (second (second x))

-- signedAs d g x a: a is not 0 and signer d g x = a (the zero guard of signedBy).
def signedAs : (d g : Hash) -> (x : Sig) -> (a : Addr) -> Flag :=
  fun (d g : Hash) (x : Sig) (a : Addr) =>
    flagIf (addrEq a 0x0000000000000000000000000000000000000000) flagNo (addrEq (signer d g x) a)

-- signer of the Mail example: the address of mailSigner. A zero s gives the address 0 (no signer).
def mailSignerOf : Addr := signer 0xf2cee375fa42b42143804025fc449deafd50cc031ca257e0b194a650a912090fu 0xc52c0ee5d84264471806290a3f2c4cecfc5490626bf912d01f240d7a274b371eu (sig 28 0x4355c47d63924e8a72e509b65029052eb6c299d53a04e167c5775fd466751c9du 0x07299936d304c153f6443dfa05f40ff007d72911b6f72307f996231605b91562u)

def noSigner : Addr := signer 0xf2cee375fa42b42143804025fc449deafd50cc031ca257e0b194a650a912090fu 0xc52c0ee5d84264471806290a3f2c4cecfc5490626bf912d01f240d7a274b371eu (sig 28 0x4355c47d63924e8a72e509b65029052eb6c299d53a04e167c5775fd466751c9du 0u)

-- Listing (S5, PLAN section 3, O72): the merchant, the sku, the price and the largest quantity, a right-nested Prod with accessors.
def Listing : Type 0 := Prod Addr (Prod U256 (Prod U256 U256))

def listing : (m : Addr) -> (k p q : U256) -> Listing :=
  fun (m : Addr) (k p q : U256) => pair m (pair k (pair p q))

def merchant : (l : Listing) -> Addr := fun (l : Listing) => first l

def sku : (l : Listing) -> U256 := fun (l : Listing) => first (second l)

def price : (l : Listing) -> U256 := fun (l : Listing) => first (second (second l))

def maxQty : (l : Listing) -> U256 := fun (l : Listing) => second (second (second l))

-- listingHash l (Q-S5-4 (a)): hash4 of the merchant word, the sku, the price and the largest quantity.
def listingHash : (l : Listing) -> Hash :=
  fun (l : Listing) => hash4 (addrToU256 (merchant l)) (sku l) (price l) (maxQty l)

-- side b h s (O69, O79): hash h s for the side bit 0 and hash s h for the side bit 1. flagIf selects the word, thus side lowers at a word position (Q-S5-5 (b)).
def side : (b : Nat) -> (h s : Hash) -> Hash :=
  fun (b : Nat) (h s : Hash) => flagIf (natEq b 0) (hash h s) (hash s h)

-- mstep s p: one Merkle step of the pair (index, hash) with the sibling s.
def mstep : (s : Hash) -> (p : Prod Nat Hash) -> Prod Nat Hash :=
  fun (s : Hash) (p : Prod Nat Hash) => pair (natDiv (first p) 2) (side (natMod (first p) 2) (second p) s)

-- merkle i h sib (Q-S5-1 (a), O70): the Merkle root of the leaf h at the index i. The List fold does the end of the list first, so sib lists the siblings from the root down.
def merkle : (i : Nat) -> (h : Hash) -> (sib : List Hash) -> Hash :=
  fun (i : Nat) (h : Hash) (sib : List Hash) => second (fold mstep (pair i h) sib)

-- merkle2 i h s1 s0 (Q-S5-3 (a)): the Merkle root of depth 2 (two mstep calls). s1 is the sibling below the root and s0 is the sibling of the leaf.
def merkle2 : (i : Nat) -> (h s1 s0 : Hash) -> Hash :=
  fun (i : Nat) (h s1 s0 : Hash) => second (mstep s1 (mstep s0 (pair i h)))

-- ProvAt r l (Q-S5-1 (a)): the index of l, the siblings from the root down and a path from the root that they give to r. A wrong sibling has no path (NO_PATH; PATH_END in the guest).
def ProvAt : (r : Hash) -> (l : Listing) -> Type 0 :=
  fun (r : Hash) (l : Listing) => (i : Nat) * (sib : List Hash) * Path Hash (merkle i (listingHash l) sib) r

-- Signed d a g (Q-S5-2 (a)): a signature x and a path from signedAs d g x a to flagYes.
def Signed : (d : Hash) -> (a : Addr) -> (g : Hash) -> Type 0 :=
  fun (d : Hash) (a : Addr) (g : Hash) => (x : Sig) * Path Flag (signedAs d g x a) flagYes

-- The EIP-712 type hashes (S5): keccak256 of `View(bytes32 root,uint256 id)` and of `EIP712Domain(uint256 chainId,address verifyingContract)`.
def viewType : Hash := 0x222ffd999f91ddddd8de1984b4ebbfda91177924d318fed0894cf2fe60c6c111u

def domainType : Hash := 0x47e79534a245952e8b16893a336b85a3d9ea9fa8c573f3d803afb92a79469218u

-- The type hashes of S6 s1 (O87, O88): keccak256 of `Cred(uint256 sid,address merchant,bytes32 root)` and of `Confirm(uint256 sid,bytes32 cartHash,bytes32 claimHash)`.
def credType : Hash := 0x09e00105c4cc9ccb9d1dd716416fcdadbf3af31522e564edec8aef6de2db80ecu

def confirmType : Hash := 0x800e2b12d123945af1fbb0025b679ceb109f8b141c9d2c6f2cb2727997dde65bu

-- ViewAt d a n (Q-S5-2 (a), O75): a Merkle root of listings and the signature of the viewer a on (root, n). The View d m of PLAN section 3 is ViewAt d (viewer m) (id m) when Mandate is in (S5 s2).
def ViewAt : (d : Hash) -> (a : Addr) -> (n : U256) -> Type 0 :=
  fun (d : Hash) (a : Addr) (n : U256) => (r : Hash) * Signed d a (hash3 viewType r n)

def root : (d : Hash) -> (a : Addr) -> (n : U256) -> (v : ViewAt d a n) -> Hash :=
  fun (d : Hash) (a : Addr) (n : U256) (v : ViewAt d a n) => witness v

-- Prov d a n v l (O75): ProvAt into the root of the view v.
def Prov : (d : Hash) -> (a : Addr) -> (n : U256) -> (v : ViewAt d a n) -> (l : Listing) -> Type 0 :=
  fun (d : Hash) (a : Addr) (n : U256) (v : ViewAt d a n) (l : Listing) => ProvAt (root d a n v) l

-- Closed terms (S5 s1): two listings of the merchant 0x..aa. The leaf demoL0 is at the index 0, with the siblings 7u and listingHash demoL1 from the root down.
def demoL0 : Listing := listing 0x00000000000000000000000000000000000000aa 1u 100u 5u

def demoL1 : Listing := listing 0x00000000000000000000000000000000000000aa 2u 250u 1u

def demoListingHash : Hash := listingHash demoL0

def demoSib : List Hash := cons 7u (cons (listingHash demoL1) nil)

def demoRoot : Hash := merkle 0 (listingHash demoL0) demoSib

def demoRoot2 : Hash := merkle2 0 (listingHash demoL0) 7u (listingHash demoL1)

-- The domain of the defaults of `evm run` (the chain id 1337 and the contract address 0x..7265636569766572), as in the guest run of the checker.
def demoDomain : Hash := hash3 domainType 1337u (addrToU256 0x0000000000000000000000007265636569766572)

def demoId : U256 := 1u

-- demoSig: the r and s of the Mail example on another digest. ecrecover gives a signer that is not 0, and no private key is necessary.
def demoSig : Sig := sig 28 0x4355c47d63924e8a72e509b65029052eb6c299d53a04e167c5775fd466751c9du 0x07299936d304c153f6443dfa05f40ff007d72911b6f72307f996231605b91562u

def demoSigner : Addr := signer demoDomain (hash3 viewType demoRoot demoId) demoSig

-- domainOf env (Q-S5-2 (a)): the EIP-712 domain separator of the chain id and the contract address of the Env.
def domainOf : (env : Env) -> Hash :=
  fun (env : Env) => hash3 domainType (chainid env) (addrToU256 (self env))

-- Views over words for test/precompile.sh (Q-S5-3 (a)): the domain separator, listingHash and merkle2 (Q-S5-5 (b), O79).
def domainWord : (env : Env) -> (s : State) -> U256 :=
  fun (env : Env) (s : State) => domainOf env

def listingHashV : (env : Env) -> (s : State) -> (m : Addr) -> (k p q : U256) -> U256 :=
  fun (env : Env) (s : State) (m : Addr) (k p q : U256) => listingHash (listing m k p q)

def merkle2V : (env : Env) -> (s : State) -> (i : Nat) -> (h s1 s0 : U256) -> U256 :=
  fun (env : Env) (s : State) (i : Nat) (h s1 s0 : U256) => merkle2 i h s1 s0

-- demoView: the view of demoRoot that the viewer 0x544388f72794e2cde7ebedba31f94dd15438965d signed (demoSigner, from `langc --kit eval`). The checker computes signedAs.
def demoView : ViewAt demoDomain 0x544388f72794e2cde7ebedba31f94dd15438965d demoId := pack demoRoot (pack demoSig refl)

-- demoProv: the provenance of demoL0 in demoView. The checker computes the Merkle root.
def demoProv : Prov demoDomain 0x544388f72794e2cde7ebedba31f94dd15438965d demoId demoView demoL0 := pack 0 (pack demoSib refl)

-- Mandate (S5 s2, PLAN 4.1 and 4.9, O72): the 11 fields as a right-nested Prod with accessors.
def Mandate : Type 0 := Prod Addr (Prod Addr (Prod Addr (Prod Addr (Prod Addr (Prod U256 (Prod U256 (Prod U256 (Prod U256 (Prod Addr U256)))))))))

def mandate : (o a w v t : Addr) -> (c al e n : U256) -> (pv : Addr) -> (pi : U256) -> Mandate :=
  fun (o a w v t : Addr) (c al e n : U256) (pv : Addr) (pi : U256) => pair o (pair a (pair w (pair v (pair t (pair c (pair al (pair e (pair n (pair pv pi)))))))))

def owner : (m : Mandate) -> Addr := fun (m : Mandate) => first m

def agent : (m : Mandate) -> Addr := fun (m : Mandate) => first (second m)

def viewer : (m : Mandate) -> Addr := fun (m : Mandate) => first (second (second m))

def vault : (m : Mandate) -> Addr := fun (m : Mandate) => first (second (second (second m)))

def token : (m : Mandate) -> Addr := fun (m : Mandate) => first (second (second (second (second m))))

def cap : (m : Mandate) -> U256 := fun (m : Mandate) => first (second (second (second (second (second m)))))

def autoLimit : (m : Mandate) -> U256 := fun (m : Mandate) => first (second (second (second (second (second (second m))))))

def expiry : (m : Mandate) -> U256 := fun (m : Mandate) => first (second (second (second (second (second (second (second m)))))))

def id : (m : Mandate) -> U256 := fun (m : Mandate) => first (second (second (second (second (second (second (second (second m))))))))

def policyVerifier : (m : Mandate) -> Addr := fun (m : Mandate) => first (second (second (second (second (second (second (second (second (second m)))))))))

def policyId : (m : Mandate) -> U256 := fun (m : Mandate) => second (second (second (second (second (second (second (second (second (second m)))))))))

-- View d m (O75): the view of the viewer of m on the id of m.
def View : (d : Hash) -> (m : Mandate) -> Type 0 := fun (d : Hash) (m : Mandate) => ViewAt d (viewer m) (id m)

-- Session d m (PLAN section 3): the session id, the merchant and the view. Listing has the name merchant, thus the accessors are sid, smerchant and sview (O81).
def Session : (d : Hash) -> (m : Mandate) -> Type 0 := fun (d : Hash) (m : Mandate) => Prod U256 (Prod Addr (View d m))

def sid : (d : Hash) -> (m : Mandate) -> (s : Session d m) -> U256 := fun (d : Hash) (m : Mandate) (s : Session d m) => first s

def smerchant : (d : Hash) -> (m : Mandate) -> (s : Session d m) -> Addr := fun (d : Hash) (m : Mandate) (s : Session d m) => first (second s)

def sview : (d : Hash) -> (m : Mandate) -> (s : Session d m) -> View d m := fun (d : Hash) (m : Mandate) (s : Session d m) => second (second s)

-- Le a b (Q-S5-7 (a), O82): the kit has no Le, so a path from u256Le a b to flagYes. A q over the bound has no path (PATH_END in the guest).
def Le : (a b : U256) -> Type 0 := fun (a b : U256) => Path Flag (u256Le a b) flagYes

-- Lt a b (S6 s1, Q-S6-6 (a)): the strict order in the canonStep form. Lt a a has no path (PATH_END in the guest).
def Lt : (a b : U256) -> Type 0 := fun (a b : U256) => Path Flag (flagIf (u256Eq a b) flagNo (u256Le a b)) flagYes

-- Line d m s (PLAN section 3): a listing, a quantity, the provenance in the view of s, a path to the merchant of s and the bound maxQty.
def Line : (d : Hash) -> (m : Mandate) -> (s : Session d m) -> Type 0 :=
  fun (d : Hash) (m : Mandate) (s : Session d m) => (l : Listing) * (q : U256) * (p : Prov d (viewer m) (id m) (sview d m s) l) * (e : Path Addr (merchant l) (smerchant d m s)) * Le q (maxQty l)

def lineListing : (d : Hash) -> (m : Mandate) -> (s : Session d m) -> (x : Line d m s) -> Listing := fun (d : Hash) (m : Mandate) (s : Session d m) (x : Line d m s) => witness x

def lineQty : (d : Hash) -> (m : Mandate) -> (s : Session d m) -> (x : Line d m s) -> U256 := fun (d : Hash) (m : Mandate) (s : Session d m) (x : Line d m s) => witness (payload x)

-- lineHash x (Q-S5-6 (a)): hash of the listing hash and the quantity.
def lineHash : (d : Hash) -> (m : Mandate) -> (s : Session d m) -> (x : Line d m s) -> Hash :=
  fun (d : Hash) (m : Mandate) (s : Session d m) (x : Line d m s) => hash (listingHash (lineListing d m s x)) (lineQty d m s x)

-- canonStep k a (Q-S5-6 (a), O70): the List fold does the end first, so k is the key before the key of a. The state is (count, key, ok); ok stays flagYes while each key is strictly less than the next key.
def canonStep : (k : Hash) -> (a : Prod Nat (Prod Hash Flag)) -> Prod Nat (Prod Hash Flag) :=
  fun (k : Hash) (a : Prod Nat (Prod Hash Flag)) => pair (natAdd (first a) 1) (pair k (flagIf (natEq (first a) 0) flagYes (flagIf (second (second a)) (flagIf (u256Eq k (first (second a))) flagNo (u256Le k (first (second a)))) flagNo)))

-- canonical d m s ls (PLAN 4.4, O73): flagYes when the listing hashes of the lines strictly increase.
def canonical : (d : Hash) -> (m : Mandate) -> (s : Session d m) -> (ls : List (Line d m s)) -> Flag :=
  fun (d : Hash) (m : Mandate) (s : Session d m) (ls : List (Line d m s)) => second (second (fold (fun (x : Line d m s) (a : Prod Nat (Prod Hash Flag)) => canonStep (listingHash (lineListing d m s x)) a) (pair 0 (pair 0u flagYes)) ls))

-- Cart d m s (Q-S5-6 (a)): the canonical form of the Bag of PLAN 4.4, a list of lines in strictly increasing order of the listing hash. Another order has no path (PATH_END in the guest, NOT_CANONICAL on the chain).
def Cart : (d : Hash) -> (m : Mandate) -> (s : Session d m) -> Type 0 :=
  fun (d : Hash) (m : Mandate) (s : Session d m) => (ls : List (Line d m s)) * Path Flag (canonical d m s ls) flagYes

-- cartHash c (PLAN 4.4, Q-S5-6 (a)): the List fold of hash over the line hashes, from 0u.
def cartHash : (d : Hash) -> (m : Mandate) -> (s : Session d m) -> (c : Cart d m s) -> Hash :=
  fun (d : Hash) (m : Mandate) (s : Session d m) (c : Cart d m s) => fold (fun (x : Line d m s) (h : Hash) => hash (lineHash d m s x) h) 0u (witness c)

-- total d m s c (S6 s1, Q-S6-2 (a)): the List fold of the price times the quantity of each line, from 0u. u256Mul and u256Add trap on an overflow.
def total : (d : Hash) -> (m : Mandate) -> (s : Session d m) -> (c : Cart d m s) -> U256 :=
  fun (d : Hash) (m : Mandate) (s : Session d m) (c : Cart d m s) => fold (fun (x : Line d m s) (acc : U256) => u256Add (u256Mul (price (lineListing d m s x)) (lineQty d m s x)) acc) 0u (witness c)

-- Closed terms (S5 s2): the mandate of the viewer demoSigner with the id demoId, no policy verifier.
def demoMandate : Mandate := mandate 0x0000000000000000000000000000000000000001 0x0000000000000000000000000000000000000002 0x544388f72794e2cde7ebedba31f94dd15438965d 0x0000000000000000000000000000000000000004 0x0000000000000000000000000000000000000005 1000u 100u 2000000000u demoId 0x0000000000000000000000000000000000000000 0u

def demoSession : Session demoDomain demoMandate := pair 9u (pair 0x00000000000000000000000000000000000000aa demoView)

def demoProv1 : Prov demoDomain 0x544388f72794e2cde7ebedba31f94dd15438965d demoId demoView demoL1 := pack 1 (pack (cons 7u (cons (listingHash demoL0) nil)) refl)

def demoLine : Line demoDomain demoMandate demoSession := pack demoL0 (pack 2u (pack demoProv (pack refl refl)))

def demoLine1 : Line demoDomain demoMandate demoSession := pack demoL1 (pack 1u (pack demoProv1 (pack refl refl)))

-- demoCart: listingHash demoL1 is less than listingHash demoL0, so demoLine1 is first.
def demoCart : Cart demoDomain demoMandate demoSession := pack (cons demoLine1 (cons demoLine nil)) refl

def demoViewer : Addr := viewer demoMandate

def demoMid : U256 := id demoMandate

def demoPolicyId : U256 := policyId demoMandate

def demoSid : U256 := sid demoDomain demoMandate demoSession

def demoLineHash : Hash := lineHash demoDomain demoMandate demoSession demoLine

def demoCartHash : Hash := cartHash demoDomain demoMandate demoSession demoCart

-- Cred d m s (S6 s1, O87): the signature of the vault of m on the session id, the merchant word and the root of the view of s. A credential of another session has no path (PATH_END in the guest).
def Cred : (d : Hash) -> (m : Mandate) -> (s : Session d m) -> Type 0 :=
  fun (d : Hash) (m : Mandate) (s : Session d m) => Signed d (vault m) (hash4 credType (sid d m s) (addrToU256 (smerchant d m s)) (root d (viewer m) (id m) (sview d m s)))

-- Confirmed d m s c k (S6 s1, O88): the signature of the viewer of m on the session id, the cart hash and the claim hash k.
def Confirmed : (d : Hash) -> (m : Mandate) -> (s : Session d m) -> (c : Cart d m s) -> (k : Hash) -> Type 0 :=
  fun (d : Hash) (m : Mandate) (s : Session d m) (c : Cart d m s) (k : Hash) => Signed d (viewer m) (hash4 confirmType (sid d m s) (cartHash d m s c) k)

-- Gate d m s c spent k (Q-S6-4 (b)): the new spent amount is not more than the autoLimit of m, or the viewer of m confirmed the cart.
def Gate : (d : Hash) -> (m : Mandate) -> (s : Session d m) -> (c : Cart d m s) -> (spent : U256) -> (k : Hash) -> Type 0 :=
  fun (d : Hash) (m : Mandate) (s : Session d m) (c : Cart d m s) (spent : U256) (k : Hash) => Sum (Le (u256Add spent (total d m s c)) (autoLimit m)) (Confirmed d m s c k)

-- Spend d m spent now k (PLAN section 3, S6 s1): a session, a cart, the credential, the cap bound, the expiry bound and the gate. spent is the contract state and now is the block time. PolicyOk (S9) and the used session id (O16, S7) are not in the S6 Spend.
def Spend : (d : Hash) -> (m : Mandate) -> (spent now : U256) -> (k : Hash) -> Type 0 :=
  fun (d : Hash) (m : Mandate) (spent now : U256) (k : Hash) => (s : Session d m) * (c : Cart d m s) * (r : Cred d m s) * (b : Le (u256Add spent (total d m s c)) (cap m)) * (t : Lt now (expiry m)) * Gate d m s c spent k
-- END COPY

-- stMandate s: the stored words as the Mandate of the copy.
def stMandate : (s : State) -> Mandate :=
  fun (s : State) => mandate (mOwner s) (mAgent s) (mViewer s) (mVault s) (mToken s) (mCap s) (mAutoLimit s) (mExpiry s) (mId s) (mPolicyVerifier s) (mPolicyId s)

-- The refusal codes (O115): words, 0 is ok, then the rows of PLAN 4.8 in order, then BAD_CALLDATA and NO_MANDATE.
def codeOk : U256 := 0u
def codeNoView : U256 := 1u
def codeNoPath : U256 := 2u
def codeWrongMerchant : U256 := 3u
def codeNotCanonical : U256 := 4u
def codeWrongSession : U256 := 5u
def codeOverCap : U256 := 6u
def codeExpired : U256 := 7u
def codeNeedConfirm : U256 := 8u
def codeReplay : U256 := 9u
def codeNoPolicy : U256 := 10u
def codeBadCalldata : U256 := 11u
def codeNoMandate : U256 := 12u

-- Entry grant (PLAN section 7, O118): store the mandate and the merchant (Q-S7-8 (b)), set spent to 0 and revoked to flagNo. used stays: a used session id stays used.
-- Revert (none) when the caller is not the contract address (the user sends to the own account, EIP-7702).
def grant : (env : Env) -> (s : State) -> (o a w v t : Addr) -> (c al e n : U256) -> (pv : Addr) -> (pi : U256) -> (mc : Addr) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (o a w v t : Addr) (c al e n : U256) (pv : Addr) (pi : U256) (mc : Addr) =>
    flagIf (addrEq (caller env) (self env)) (some (pair (makeState o a w v t c al e n pv pi mc 0u (used s) flagNo) nil)) none

-- Entry revoke (PLAN section 7, O118): set revoked to flagYes. Revert (none) when the caller is not the contract address.
def revoke : (env : Env) -> (s : State) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) =>
    flagIf (addrEq (caller env) (self env)) (some (pair (makeState (mOwner s) (mAgent s) (mViewer s) (mVault s) (mToken s) (mCap s) (mAutoLimit s) (mExpiry s) (mId s) (mPolicyVerifier s) (mPolicyId s) (mMerchant s) (spent s) (used s) flagYes) nil)) none

-- The decoder (S7 s2, O136, O137; Q-S7-7 (a), Q-S7-8): check and execute read the calldata xs with one fold of a Prod of 30 words.
-- The fold reads the end of xs first (O70). The 13 header words are at the end: sid, the merchant word, root, the view sig (v, r, s),
-- the cred sig (v, r, s), the claim hash k, the confirm sig (v, r, s). Then the lines, the last line of the cart first: the merchant
-- word, sku, price, maxQty, qty, the depth n (8 or less), then n pairs (a direction word, a sibling) from the leaf up.
-- The direction 0u gives hash h s and 1u gives hash s h. Another direction word, a depth over 8, a short list or a list that stops
-- in a line gives BAD_CALLDATA. The slots: pos bad sid mw root vv vr vs cv cr cs k fv fr fs lp lm lk lpr lmq lq ld lh ldir ch tot ck cn err ovf.
-- err starts at 0u. Each line adds the weight of its first failed check: NO_PATH 2^128, WRONG_MERCHANT 2^64, NOT_CANONICAL 1.
